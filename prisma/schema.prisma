datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
enum Status {
  EM_ESTOQUE
  SAIU
}

enum TipoMov {
  ENTRADA
  SAIDA
  MOVIMENTACAO
}


model Marca {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  modelos Modelo[]
}

model Modelo {
  id       Int       @id @default(autoincrement())
  nome     String
  marcaId  Int
  marca    Marca     @relation(fields: [marcaId], references: [id])
  produtos Produto[]

  @@unique([marcaId, nome])
}

model Localizacao {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  posicoes Posicao[]
}

model Posicao {
  id            Int            @id @default(autoincrement())
  nome          String
  localizacaoId Int
  localizacao   Localizacao    @relation(fields: [localizacaoId], references: [id])
  produtos      Produto[]
  saidasDe      Movimentacao[] @relation("Origem")
  chegadasEm    Movimentacao[] @relation("Destino")

  @@unique([localizacaoId, nome])
}

model Funcionario {
  id            Int            @id @default(autoincrement())
  nome          String
  matricula     String?        @unique
  movimentacoes Movimentacao[]
}

model Produto {
  id            Int            @id @default(autoincrement())
  nome          String
  serviceTag    String         @unique
  ni            String         @unique
  quantidade    Int            @default(1)
  status        Status         @default(EM_ESTOQUE)
  modeloId      Int
  modelo        Modelo         @relation(fields: [modeloId], references: [id])
  posicaoId     Int?
  posicao       Posicao?       @relation(fields: [posicaoId], references: [id])
  criadoEm      DateTime       @default(now())
  movimentacoes Movimentacao[]
}

model Movimentacao {
  id               Int         @id @default(autoincrement())
  tipo             TipoMov
  quantidade       Int         @default(1)
  data             DateTime    @default(now())
  produtoId        Int
  produto          Produto     @relation(fields: [produtoId], references: [id])
  funcionarioId    Int
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id])
  origemPosicaoId  Int?
  origem           Posicao?    @relation("Origem", fields: [origemPosicaoId], references: [id])
  destinoPosicaoId Int?
  destino          Posicao?    @relation("Destino", fields: [destinoPosicaoId], references: [id])
  observacao       String?
}