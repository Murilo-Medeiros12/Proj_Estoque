// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// ENUMS
// ==========================================

enum TipoEvento {
  PROVENTO
  DESCONTO
}

enum TipoAtividade {
  pratica
  simulacao
  documento
  calculo
}

enum MecanismoAtividade {
  empresas
  cargos
  funcionarios
  ponto
  aso
  folha
  custos
  contratacao
}

enum StatusPonto {
  REGULAR
  ATRASO
}

enum ResultadoASO {
  APTO
  INAPTO
}

enum TipoNotificacao {
  NOVA_ATIVIDADE
  ATIVIDADE_CONCLUIDA
}

enum DestinoNotificacao {
  PROFESSOR
  ALUNO
}

// ==========================================
// CADASTROS BASE
// ==========================================

model Empresa {
  id           String        @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String        @unique
  cidadeUF     String?
  setores      Setor[]
  funcionarios Funcionario[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Setor {
  id        String  @id @default(cuid())
  nome      String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
}

model Cargo {
  id                      String        @id @default(cuid())
  codigo                  String        @unique
  titulo                  String
  salarioBase             Float
  jornadaMensal           Int
  adicionalInsalubridade  Boolean       @default(false)
  adicionalPericulosidade Boolean       @default(false)
  funcionarios            Funcionario[]
}

model Funcionario {
  id           String           @id @default(cuid())
  codigo       String           @unique
  empresa      Empresa          @relation(fields: [empresaId], references: [id])
  empresaId    String
  nome         String
  cpf          String           @unique
  cargo        Cargo            @relation(fields: [cargoId], references: [id])
  cargoId      String
  salarioBase  Float
  dependentes  Int              @default(0)
  dataAdmissao DateTime
  folhas       FolhaPagamento[]
  pontos       RegistroPonto[]
  asos         RegistroASO[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ==========================================
// PONTO E ASO
// ==========================================

model RegistroPonto {
  id            String      @id @default(cuid())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  data          DateTime
  entrada       String
  saidaAlmoco   String
  retornoAlmoco String
  saida         String
  horasExtras   String      @default("0h")
  status        StatusPonto @default(REGULAR)
  createdAt     DateTime    @default(now())
}

model RegistroASO {
  id            String       @id @default(cuid())
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  tipo          String
  medico        String
  data          DateTime
  resultado     ResultadoASO @default(APTO)
  createdAt     DateTime     @default(now())
}

// ==========================================
// FOLHA DE PAGAMENTO
// ==========================================

model EventoFolha {
  codigo            String      @id
  nome              String
  tipo              TipoEvento
  percentualFixa    Float?
  incideINSS        Boolean     @default(false)
  incideIRRF        Boolean     @default(false)
  incideFGTS        Boolean     @default(false)
  descricaoDidatica String
  itens             ItemFolha[]
}

model FolhaPagamento {
  id              String      @id @default(cuid())
  funcionario     Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId   String
  mesReferencia   String
  totalProventos  Float
  totalDescontos  Float
  salarioLiquido  Float
  fgtsDoMes       Float
  itens           ItemFolha[]
  createdAt       DateTime    @default(now())

  @@unique([funcionarioId, mesReferencia])
}

model ItemFolha {
  id             String         @id @default(cuid())
  folha          FolhaPagamento @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  folhaId        String
  evento         EventoFolha    @relation(fields: [codigoEvento], references: [codigo])
  codigoEvento   String
  tipo           TipoEvento
  referencia     String
  valorCalculado Float
  memoriaCalculo String
}

// ==========================================
// TURMAS E ALUNOS
// ==========================================

model Turma {
  id         String     @id @default(cuid())
  nome       String
  alunos     Aluno[]
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Aluno {
  id           String               @id @default(cuid())
  nome         String
  matricula    String               @unique
  turma        Turma                @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId      String
  conclusoes   AtividadeConclusao[]
  notificacoes Notificacao[]
  createdAt    DateTime             @default(now())
}

model AtividadeConclusao {
  id          String   @id @default(cuid())
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId  String
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId     String
  concluidaEm DateTime @default(now())

  @@unique([activityId, alunoId])
}

model Notificacao {
  id        String             @id @default(cuid())
  mensagem  String
  tipo      TipoNotificacao
  destino   DestinoNotificacao
  aluno     Aluno?             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId   String?
  lida      Boolean            @default(false)
  createdAt DateTime           @default(now())
}

// ==========================================
// ATIVIDADES (curso)
// ==========================================

model Activity {
  id           String               @id @default(cuid())
  type         TipoAtividade
  title        String
  statement    String
  instructions String
  mechanism    MecanismoAtividade
  className    String
  createdBy    String
  turma        Turma?               @relation(fields: [turmaId], references: [id])
  turmaId      String?
  conclusoes   AtividadeConclusao[]
  createdAt    DateTime             @default(now())
}